#!/usr/bin/env python3
"""Print the codename currently published by Ubuntu's devel archive."""

import re
import sys
import urllib.request

RELEASE_URL = "https://archive.ubuntu.com/ubuntu/dists/devel/Release"


def devel_codename():
    with urllib.request.urlopen(RELEASE_URL, timeout=30) as response:
        for line in response.read().decode("utf-8").splitlines():
            match = re.fullmatch(r"Codename:\s*([a-z]+)\s*", line)
            if match:
                return match.group(1)
    raise RuntimeError("no valid Codename field in %s" % RELEASE_URL)


def main():
    print(devel_codename())
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, UnicodeError, RuntimeError) as exc:
        print("detect-devel-series: %s" % exc, file=sys.stderr)
        sys.exit(1)
